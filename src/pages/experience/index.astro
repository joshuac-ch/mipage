---
import "../../styles/global.css";
import Header from "@/components/Header/Header";
import Foot from "@/components/Footer/Foot.astro";

import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { getCollection } from "astro:content";
import { Briefcase } from "lucide-react";

const experience_data = await getCollection("experience");
---

<meta charset="utf-8" />
<video
    autoplay
    loop
    muted
    class="fixed inset-0 z-[-1] h-full w-full object-cover pointer-events-none"
>
    <source src="/fondo4.mp4" type="video/mp4" />
</video>

<div
    class="text-white/80 sticky top-0 z-50 backdrop-blur-xl border-1 border-white/5 bg-white/5"
>
    <Header client:load />
</div>

<div class="text-white/80 relative backdrop-blur-xl bg-white/5 p-4">
    <div class="flex flex-col justify-center items-center w-full pt-20 pb-20">
        <section class="w-full">
            <h1 class="text-2xl text-center font-semibold">Experiencia</h1>
        </section>

        <section class="mt-8">
            <div class="relative w-full px-10 py-10">
                {/* Línea vertical fija */}
                <div
                    class="absolute top-10 bottom-10 left-[calc(2.5rem+11px)] w-px bg-white/20"
                >
                </div>

                {/* Punto superior */}
                <div
                    class="absolute top-10 left-10 h-6 w-6 rounded-full bg-white/20"
                >
                </div>

                {/* Experiencias */}
                <div class="relative flex flex-col gap-16">
                    {
                        experience_data.map((ex) => {
                            const { titulo, descri, fecha, empresa } = ex.data;

                            return (
                                <div class="relative flex min-h-14 items-center gap-2 pl-0">
                                    {/* Nodo alineado con la línea */}
                                    <div class="z-10 flex items-center h-6 w-6 justify-center rounded-full border border-white/20 ">
                                        <Briefcase className=" h-6 w-6 text-indigo-500" />
                                    </div>

                                    {/* Contenido */}
                                    <div class="min-w-0 inline-block rounded-md bg-white/20 px-4 py-2 w-200">
                                        <span class="text-white/20">
                                            {fecha}
                                        </span>
                                        <p>{empresa}</p>
                                        <p>{titulo}</p>
                                        <p>{descri}</p>
                                    </div>
                                </div>
                            );
                        })
                    }
                </div>

                {/* Punto inferior */}
                <div
                    class="absolute bottom-10 left-10 h-6 w-6 rounded-full bg-white/20"
                >
                </div>
            </div>
        </section>
    </div>
    <Foot />
</div>
