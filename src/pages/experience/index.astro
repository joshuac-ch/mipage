---
import "../../styles/global.css";
import Header from "@/components/Header/Header";
import Foot from "@/components/Footer/Foot.astro";

import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { getCollection } from "astro:content";
import { Briefcase, Building } from "lucide-react";

const experience_data = await getCollection("experience");
const ConversionTimeExperience = (date) => {
    const [starDate, endDate] = date.split(" - ");
    const start = new Date(starDate);
    const end = new Date(endDate);

    let years = end.getFullYear() - start.getFullYear();
    let months = end.getMonth() - start.getMonth();

    const result = [];

    if (years > 0) {
        result.push(`${years} ${years === 1 ? "año" : "años"}`);
    }

    if (months > 0) {
        result.push(`${months} ${months === 1 ? "mes" : "meses"}`);
    }

    if (result.length === 0) {
        return "Menos de 1 mes";
    }

    return result.join(" y ");
};
---

<meta charset="utf-8" />
<video
    autoplay
    loop
    muted
    class="fixed inset-0 z-[-1] h-full w-full object-cover pointer-events-none"
>
    <source src="/fondo4.mp4" type="video/mp4" />
</video>

<div
    class="text-white/80 sticky top-0 z-50 backdrop-blur-xl border-1 border-white/5 bg-white/5"
>
    <Header client:load />
</div>

<div class="text-white/80 relative backdrop-blur-xl bg-white/5 p-4">
    <div class="flex flex-col justify-center items-center w-full pt-20 pb-20">
        <section class="w-full">
            <h1 class="text-3xl text-center font-semibold">
                Experiencia Laboral
            </h1>
        </section>

        <section class="mt-8">
            <div class="relative w-full px-8 py-10">
                {/* Línea vertical fija */}
                <div
                    class="absolute top-0 bottom-0
                left-[calc(2.5rem+10px)] w-px bg-indigo-400 border-2 border-indigo-400"
                >
                </div>

                {
                    (
                        /* Punto superior */
                        <div class="absolute top-0 left-10 h-6 w-6 rounded-full bg-indigo-400" />
                    )
                }

                {/* Experiencias */}
                <div class="relative flex flex-col gap-16">
                    {
                        experience_data.map((ex) => {
                            const {
                                titulo,
                                descri,
                                fecha,
                                empresa,
                                icon_company,
                                sector,
                            } = ex.data;
                            return (
                                <div class="relative flex min-h-14 items-start gap-2 mt-10">
                                    {/* Nodo alineado con la línea */}
                                    <div
                                        class="z-10 flex items-center h-10 w-10 justify-center
                                     rounded-md border border-indigo-400 bg-indigo-400"
                                    >
                                        <span class="">
                                            <Briefcase className=" h-6 w-6 text-white" />
                                        </span>
                                    </div>
                                    {/* Contenido */}
                                    <div class="pt-4 min-w-0 inline-block rounded-md bg-white/10 px-4 py-2 md:w-200">
                                        <div class="flex flex-row justify-between items-center">
                                            <div class="">
                                                <span class="text-white/20">
                                                    {fecha}
                                                </span>
                                                <span>
                                                    ~
                                                    {ConversionTimeExperience(
                                                        fecha,
                                                    )}
                                                </span>
                                            </div>
                                            <div
                                                class="text-indigo-300 px-3 
                                            bg-indigo-800/20 border-indigo-400 border-1 py-1 rounded-full"
                                            >
                                                <p class="font-medium text-[12px]">
                                                    Sector {sector}
                                                </p>
                                            </div>
                                        </div>
                                        <div class="flex font-semibold flex-col">
                                            <p>{titulo}</p>
                                            <div class="flex text-indigo-400 flex-row items-center gap-2">
                                                <Building />
                                                <p>{empresa}</p>
                                            </div>
                                        </div>
                                        <div class="mt-4 max-w-none">
                                            <p class="text-sm font-medium leading-7 text-white/70 whitespace-pre-line break-words">
                                                {descri}
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            );
                        })
                    }
                </div>

                {
                    (
                        /* Punto inferior */
                        <div
                            class="absolute bottom-0 
                    left-10 h-6 w-6 rounded-full bg-indigo-400"
                        />
                    )
                }
            </div>
        </section>
    </div>
    <Foot />
</div>
