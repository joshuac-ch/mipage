        hover:shadow-[0_0_40px_rgba(129,140,248,0.3)] transition">
          <div
            class="flex flex-row p-2 w-30 border-white/20 rounded-4xl border-1 m-4"
          >
            <Layers />
            <p class="pl-2">Stack</p>
          </div>
          <div class="flex flex-row gap-1 m-1 justify-center">
            <div class="flex flex-row flex-wrap w-76">
              {
                data.map((s) => {
                  const { logo, nombre } = s.data;
                  return (
                    <div class="border-2 hover:bg-indigo-500/10 overflow-hidden border-white/10 m-1 rounded-2xl p-2 shadow-[0_0_25px_rgba(79,70,229,0.15)] hover:shadow-[0_0_40px_rgba(129,140,248,0.3)] transition">
                      <img
                        src={logo}
                        alt={nombre}
                        class="hover:scale-105 transition-all duration-100 w-12 h-12"
                      />
                    </div>
                  );
                })
              }
            </div>
          </div>
        </div>
      </div>
    </section>
    {
      /*
    <section>
        <div>
            <h1 class="font-black text-4xl">Formacion</h1>
        </div>
    </section>
    <section>
        <div>
            <h1 class="font-black text-4xl">Contacto </h1>
        </div>
    </section> 
    */
