        <h1 id="experiencia" class="font-black text-3xl">Experiencia</h1>
        <div  class="flex md:flex-row flex-col justify-center text-xl mt-10 gap-5">
          <div class="flex flex-col">
            <div class="flex items-center mb-4">
              <i class="bxr bx-shopping-bag text-indigo-500"></i>
              <span
                class="bg-gradient-to-r from-transparent indigo-500 to-indigo-500 h-1 rounded-lg inline-block w-full"
              ></span>
            </div>
            <p class="mb-2 text-white font-semibold text-[21px]">
              Practicante desarrolador fronted
