          <h1 class="font-black text-md mb-8 underline cursor-pointer">
            <a href="/proyectos/index.html">Mostrar mas</a>
          </h1>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-8">
          <!-- Tarjeta 1 -->
          <div
            class="border border-white/10 overflow-hidden rounded-2xl shadow-[0_0_25px_rgba(79,70,229,0.15)] hover:shadow-[0_0_40px_rgba(129,140,248,0.3)] transition"
