---
import reactLogo from "../../assets/react.svg";
import vueLogo from "../../assets/vue.svg";
import awsLogo from "../../assets/aws.svg";
import dockerLogo from "../../assets/docker.svg";
import laravelLogo from "../../assets/laravel.svg";
import mongodbLogo from "../../assets/mongodb.svg";
import tsLogo from "../../assets/typescript.svg";
import pytorchLogo from "../../assets/pytorch.svg";
import pythonLogo from "../../assets/python.svg";
import tailLogo from "../../assets/tailwind.svg";
import mlLogo from "../../assets/humanize.svg";
import expressLogo from "../../assets/express.svg";
import Header from "@/components/Header/Header";
import IconLogo from "../../assets/nino.jpg";
import Foot from "@/components/Footer/Foot.astro";
import { Button } from "@/components/ui/button";
import {
  Contact,
  FileStack,
  IceCreamConeIcon,
  Info,
  InspectionPanelIcon,
  Layers,
  Mail,
  PieChart,
  PiIcon,
  Play,
  School,
} from "lucide-react";
import { getCollection } from "astro:content";
import pr1 from "../../../public/proyecto2/foto1.png";
import pr2 from "../../../public/proyecto3/foto2.png";
import { toast, Toaster } from "sonner";
const data = await getCollection("stacks");

---

<video
  autoplay
  loop
  muted
  class="absolute inset-0 w-full h-full object-cover -z-10"
>
  <source src="/fondo3.mp4" type="video/mp4" />
</video>
<div class="sticky top-0 z-50 backdrop-blur-xl border-1 border-white/5 bg-white/5">
  <Header client:load />
</div>
<div class="relative backdrop-blur-xl bg-white/5 p-4">
  
  <div class="flex flex-col justify-between items-center">
    <section class="pt-20">
      <div
        class="grid md:pl-18 grid-cols-1 items-start gap-5 md:grid-cols-2">
        <div class="flex flex-col justify-center">
          <h1 class="font-black md:text-4xl text-2xl">Hola soy Nino dev</h1>
          <h2 class="md:text-2xl text-2xl font-black mt-2">
            Ingeniero de software con I.A.
          </h2>

          <div>
            <p class="prose text-white mt-4">
              Me gusta crear sistemas que brinden satisfaccion a los clientes
              soy una persona autodidacta y responsable caracterizado por
              aprender algo nuevo, mejorando mis habilidades dia a dia.
            </p>
          </div>
          <div
            id="contenedor-img"
            class="flex flex-row  justify-between md:w-120 w-full pt-4"
          >
            <img src={reactLogo.src} class="h-13 w-13" alt="null" />
            <img src={vueLogo.src} class="h-13 w-13" alt="null" />
            <img src={awsLogo.src} class="h-13 w-13" alt="null" />
            <img src={dockerLogo.src} class="h-13 w-13" alt="null" />
            <img src={expressLogo.src} class="h-13 w-13" alt="" />
          </div>
          <div
            class="mt-4 flex flex-row items-center justify-between bg-white/10 border-white/10 border-2 rounded-md w-75"
          >
            <p class="p-2">condorenajoshua98@gmail.com</p>
            <Button
              id="copyBtn" 
              className="p-3 m-1 bg-white/20 cursor-pointer rounded-md hover:bg-indigo-200/10"
            >
              <i class="bxr bx-copy"></i>
            </Button>
          </div>
        </div>
        <div class="flex items-center justify-center">
          <img src={IconLogo.src} class="md:h-70 md:w-70 w-60 h-60 rounded-full" alt="" />
        </div>
      </div>
    </section>
    {
      /*
    <section >
        <div class="grid grid-cols-1 md:grid-cols-1 lg:grid-cols-2 ">
            <div>
                <h1 class="font-black text-4xl mb-4">Sobre Mi</h1>
                <div class="prose text-[15px] text-white">
                <p>Me gusta crear sistemas que brinden satisfaccion a los clientes soy una persona autodidacta, proactiva, responsable siempre toco el codigo.
                     Soy curioso en saber como funciona algo aprendo de manera proactiva y me gusta mejorar mis habilidades dia a dia para ofrecer un mejor 
                     servicio a mis clientes.            
                Siempre me a gustado aprender cosas nuevas lo hace mas emocionate estar en la pantalla creando cosas que nunca antes haz echo.</p>
                </div>
            </div> 
        </div>          
    </section>
