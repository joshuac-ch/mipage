                  className="bg-white/10 text-sm px-8 py-2 hover:bg-indigo-300/10"
                  >Ver</Button
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    <section class="w-full md:w-268">
      
      <div class="flex gap-8 flex-col md:flex-row justify-between mb-10">
        <div id="contactar" class=" border border-white/10 overflow-hidden rounded-2xl shadow-[0_0_25px_rgba(79,70,229,0.15)] 
