</div>

<script is:inline>
  document.getElementById("copyBtn").addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText("condorenajoshua98@gmail.com");
      alert("Se agrego al portapapeles")
    } catch (e) {
      console.error(" Hubo un error", e);
    }
  });
  const elemnto2 = document.getElementById("experiencia-2");
  const btn2 = document.getElementById("btn2");
  let open = false;
  btn2.addEventListener("click", () => {
    open = !open;
    elemnto2.classList.toggle("max-h-20", !open); //cerrado
    elemnto2.classList.toggle("max-h-50", open); //abierto
    btn2.textContent = open ? "Ver menos" : "Ver mas";
  });

  const elemento = document.getElementById("experiencia-1");
  const btn = document.getElementById("btn");
  let abierto = false;

  btn.addEventListener("click", () => {
    abierto = !abierto;
    elemento.classList.toggle("max-h-20", !abierto); // cerrado
    elemento.classList.toggle("max-h-50", abierto); // abierto
    btn.textContent = abierto ? "Ver menos" : "Ver mas";
  });
</script>
<style>
  section {
    margin-top: 20px;
  }
  #contenedor-img {
    img {
      margin: 10;
    }
  }
  .logo: {
    width: 5px;
    height: 5px;
  }
</style>
