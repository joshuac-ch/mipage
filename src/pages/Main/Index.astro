              <i class="bxr bx-shopping-bag text-indigo-500"></i>
              <span class="bg-indigo-500 h-1 rounded-lg inline-block w-full"
              ></span>
            </div>
            <p class="text-[21px] text-white font-semibold mb-2">
              Desarrolador Backend
            </p>
            <p class="text-[14px] text-gray-500 mb-4">
              Marzo 7, 2024 - Enero 10, 2025
            </p>
            <p
