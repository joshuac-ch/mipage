          hover:shadow-[0_0_40px_rgba(129,140,248,0.3)] transition">
            <div
              class="flex flex-row p-2 w-30 border-white/20 rounded-4xl border-1 m-4"
            >
              <Contact />
              <p class="ml-2">Contacto</p>
            </div>
            <div class="m-4">
              <p class="w-80">Hablemos sobre tu proximo proyecto.</p>
              <Button className="mt-4 bg-white/10 hover:bg-indigo-300/10 "
                >Enviar un Mensaje</Button
              >
            </div>
          </div>
          <div
            class="flex mt-6 border h-26 p-0 border-white/10 overflow-hidden rounded-2xl shadow-[0_0_25px_rgba(79,70,229,0.15)] hover:shadow-[0_0_40px_rgba(129,140,248,0.3)] transition"
          >
            <div
              class="flex flex-row justify-between items-center p-2 w-full m-4"
            >
