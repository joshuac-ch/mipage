---
import "../../styles/global.css";

import Foot from "@/components/Footer/Foot.astro";
import { Button } from "@/components/ui/button";
import pr1 from "../../../public/proyecto2/foto1.png";
import pr2 from "../../../public/proyecto3/foto2.png";
import { getCollection } from "astro:content";
import Header from "@/components/Header/Header";
const data=await getCollection("proyects")
const paleta=["indigo","red","blue","green","cyan","orange"]
const colores={
  indigo: "border-indigo-400 text-indigo-400",
  red: "border-red-400 text-red-400",
  blue: "border-blue-400 text-blue-400",
  green: "border-green-400 text-green-400",
  cyan: "border-cyan-400 text-cyan-400",
  orange: "border-orange-400 text-orange-400",
}
---
<meta charset='utf-8'>
<video
  autoplay
  loop
  muted
  class="absolute inset-0 w-full h-full object-cover -z-10"
>
  <source src="/fondo4.mp4" type="video/mp4" />
</video>
<div
  class="sticky top-0 z-50 backdrop-blur-xl border-1 border-white/5 bg-white/5"
>
  <Header client:load></Header>
</div>
<div class="relative backdrop-blur-xl bg-white/5 p-4">
  <div class="flex flex-col items-center justify-center w-full pt-20 pb-20">
    <section>
      <h1 class="text-2xl font-semibold">Proyectos que he realizado</h1>
    </section>
    
     <section class="mt-8">
      <div class="grid gap-3 grid-cols-1 md:grid-cols-3">
        {data.map((d,i)=>{
            const {slug}=d
            const {fondo,title,link,tag,categoria,subcategoria}=d.data
            console.log("i",colores[paleta[i]])
            return(
             <> 
            <div
            class="relative h-110 bg-white/20 rounded-2xl hover:scale-103 overflow-hidden- 
            transition-all shadow-[0_0_25px_rgba(79,70,229,0.15)] hover:shadow-[0_0_40px_rgba(129,140,248,0.3)]">
              <div class={`absolute right-2 top-2 text-[12px] border-2 py-2 px-4 font-semibold bg-zinc-900 ${colores[paleta[i]]} rounded-full`}>
                <span>{tag}</span>
              </div>
              <img
                src={fondo}
                class="max-h-60 w-110 h-75 rounded-t-2xl rounded-b-none"
                alt=""
              />
              <div class="pt-2 pl-4 pb-4 pr-4 flex flex-col justify-start md:h-35">
                <div class="font-semibold mb-1 w-100">
                  <span class="text-indigo-300">{categoria}</span> • <span class="text-zinc-300">{subcategoria}</span>
                </div>
                <div class="">
                  <p class="md:w-100 text-2xl">{title}</p>
                </div>

                <div class="flex flex-row gap-4 mt-4">
                  <div>
                    <div>
                    <Button
                      className="md:w-40 cursor-pointer bg-white/10 hover:bg-indigo-300/10"
                      ><a href={`/proyectos/${slug}/index.html`} transition:name={`img-${slug}`}>Caso de studio </a></Button>
                  </div>
                  </div>
                  <div>
                    <Button
                      className="md:w-40 cursor-pointer bg-white/10 hover:bg-indigo-300/10"
                      ><a href={link} target="_blank">Visitar Web</a></Button>
                  </div>
                </div>
              </div>
            </div>
        
          </>
        )
        })}
      </div>
   
    </section>
  </div>
  <Foot />
</div>
<style>
  html,
  body {
    background-color: #1c1b1b;
    color: white;
    margin: 0;

    backdrop-filter: blur(20px);
  }
</style>
