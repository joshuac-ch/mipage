---
import "../../styles/global.css"
import Header from "@/components/Header/Header.astro"
import Foot from "@/components/Footer/Foot.astro"
import { Button } from "@/components/ui/button"
import pr1 from "../../../public/proyecto2/foto1.png" 
import pr2 from "../../../public/proyecto3/foto2.png" 
---
<video autoplay loop  muted class="absolute inset-0 w-full h-full object-cover -z-10" >
    <source src="/src/assets/fondo4.mp4" type="video/mp4">
</video>
<div class="sticky top-0 z-50 backdrop-blur-xl  border-1 border-white/5 bg-white/5 ">
    <Header/>
</div> 
<div class="relative backdrop-blur-xl bg-white/5">
    <div class="flex flex-col items-center justify-center w-full pt-20 pb-20">
        <section >
            <h1 class="text-2xl">Proyectos que he realizado</h1>
        </section>
        <section class="mt-8">
            <div class="flex gap-3 flex-row">          
             
            <div class="bg-white/20 rounded-2xl hover:scale-103 overflow-hidden transition-all shadow-[0_0_25px_rgba(79,70,229,0.15)] hover:shadow-[0_0_40px_rgba(129,140,248,0.3)]">
                <img src={pr1.src} 
                class="max-h-60 w-110 h-75 rounded-t-2xl rounded-b-none " alt="">
                <div class="pt-2 pl-4 pb-4 pr-4">
                    <p class="text-2xl ">Proyecto de Tienda Online</p>
                            
                    <div class="flex flex-row gap-4 mt-4">
                        <div>
                            <Button className="w-40 cursor-pointer bg-white/10 hover:bg-indigo-300/10">
                            <a href="/proyectos/pr2/">Caso de estudio</a></Button>
                        </div>
                        <div>
                            <Button className="w-40 cursor-pointer bg-white/10 hover:bg-indigo-300/10">Visitar Web</Button>
                        </div>
                    </div>
                </div>
            </div>
             <div class="bg-white/20 rounded-2xl hover:scale-103 overflow-hidden transition-all shadow-[0_0_25px_rgba(79,70,229,0.15)] hover:shadow-[0_0_40px_rgba(129,140,248,0.3)]">
                <img src={pr2.src} 
                class="max-h-60 w-110 h-75 rounded-t-2xl rounded-b-none " alt="">
                <div class="pt-2 pl-4 pb-4 pr-4">
                    <p class="text-2xl ">Proyecto Spotify Clone</p>
                            
                    <div class="flex flex-row gap-4 mt-4">
                        <div>
                            <Button className="w-40 cursor-pointer bg-white/10 hover:bg-indigo-300/10">
                            <a href="/proyectos/pr1/">Caso de estudio</a></Button>
                        </div>
                        <div>
                            <Button className="w-40 cursor-pointer bg-white/10 hover:bg-indigo-300/10">Visitar Web</Button>
                        </div>
                    </div>
                </div>
            </div>
            
            </div>
        </section>
    </div>
    <Foot></Foot>
</div>
<style>
    html,
    body{
        
        background-color: #1c1b1b;
		color: white;
		margin: 0;
		
		backdrop-filter: blur(20px);
    }
</style>