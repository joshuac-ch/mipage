---
import { ClientRouter } from "astro:transitions";
import ToasterPlantila from "@/components/Components/ToasterPlantila";
import ToasterCorreo from "@/components/Components/ToasterCorreo"
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/ninohub.jpg" />
		<meta name="generator" content={Astro.generator} />
		<title>NinoDev</title>
		<link href='https://cdn.boxicons.com/fonts/basic/boxicons.min.css' rel='stylesheet'>
		
	</head>
	<body>
		<ClientRouter/>
		<slot />
		<ToasterPlantila client:load></ToasterPlantila>
		<ToasterCorreo client:load></ToasterCorreo>
	</body>
</html>

<style>
	html,
	body {
		background-color: #1c1b1b;
		color: white;
		margin: 0;
		
		backdrop-filter: blur(20px);
		
	}
</style>
